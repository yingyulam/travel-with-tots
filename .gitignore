# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Flask
instance/
.webassets-cache
*.log

# SQLite database (generated at runtime)
*.db
*.sqlite3
data/app.db

# RAG index (rebuildable from data/knowledge_base.md)
data/chroma/
data/rag_index.json
data/rag_config.json
# The 86MB ONNX embedding model, downloaded on first use. Kept here rather than
# in $HOME so a deployment's build can hand it to the running service, which
# only inherits the project directory.
data/onnx_models/
# Stage trace for diagnosing the deployed knowledge base. Written at runtime.
data/rag_trace.log
# Which backend /settings is set to. Generated, and local to one install.
data/data_source.json
# Generated from the live schema by supabase_sync.postgres_ddl(); it would
# drift the moment a column was added.
supabase_schema.sql

# Chatbot ratings (runtime data)
data/results.json
data/intents.jsonl

# Environment variables
.env
.flaskenv

# Packaging / build
build/
dist/
*.egg-info/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Claude Code
CLAUDE.md
.claude/
