# Signs session cookies. Required, with no default: a shared default is one an
# attacker has too, and the cookie is what says which parent you are logged in
# as. Generate your own:
#   python3 -c "import secrets; print('SECRET_KEY=' + secrets.token_hex(32))"
SECRET_KEY=generate-your-own-see-above

# The first admin account, created once on a fresh database. No default: the
# password used to be a literal in src/db.py, which is a password everyone who
# can read the repository also has, and it opens /settings. Without these there
# is simply no admin, and scripts/set_admin.py is how to make one later.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-something-long

OPENROUTER_API_KEY=your-openrouter-api-key-here
TAVILY_API_KEY=your-tavily-search-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Optional, for the Supabase data source on /settings. The app runs on local
# SQLite without any of them.
#
# The first two are the REST credentials the clone uses. The key must be the
# project's secret key (sb_secret_... or service_role): row-level security is
# what makes a publishable key safe in a browser, and it refuses these writes.
# Server-side only, and never sent to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-secret-key-here

# The Postgres connection string, from Connect in the Supabase dashboard. This
# is what serves pages once the dropdown is set to Supabase. Prefer the session
# pooler (port 5432); the transaction pooler on 6543 also works.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@host:5432/postgres

# Optional. Pins the data source, overriding the dropdown on /settings in both
# directions: "local" forces SQLite, "supabase" forces Supabase. A deployment
# needs this because the dropdown lives in data/data_source.json, which does not
# survive a deploy on a host with an ephemeral disk.
# DB_BACKEND=supabase

# Optional. Marks the session cookie Secure, so it is only ever sent over
# HTTPS. Leave unset for local development over http://localhost.
# SESSION_COOKIE_SECURE=true

# Optional. Whether to believe X-Forwarded-For when identifying a caller for
# rate limiting. Set it only behind a proxy that sets the header (Render does).
# Off a proxy it is a header the caller chose, so trusting it would let one
# attacker present as any number of addresses.
# TRUST_PROXY=true
